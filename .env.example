# --- Reachy Mini OpenAI Chat (Open) configuration ---
# Copy this file to `.env` (next to the app, or in
# ~/.config/reachy_mini_openai_chat_open/.env) and fill in your key.

# REQUIRED: your OpenAI API key (needs Realtime API access).
OPENAI_API_KEY=sk-your-key-here

# --- Optional: model & voice ---
# Realtime model: gpt-realtime | gpt-realtime-2
OPENAI_REALTIME_MODEL=gpt-realtime
# Voice: marin, cedar, alloy, echo, shimmer, ...
OPENAI_REALTIME_VOICE=marin

# --- Optional: personality ---
# (Conversations are always in English.)
# REACHY_INSTRUCTIONS=You are Reachy Mini, a warm and playful desk robot...
# Spoken word for word on start, so write it as the line you want to hear.
# REACHY_GREETING=Hi, I'm Reachy! What's on your mind?
REACHY_GREET_ON_START=true

# --- Optional: behaviour toggles ---
REACHY_ENABLE_CAMERA=true      # camera vision + face tracking available
REACHY_FACE_TRACKING=false     # start with face-follow on (model can toggle it)
REACHY_AMBIENT=true            # ambient "breathing" + idle motion
REACHY_HALF_DUPLEX=false       # true = mute mic while robot talks (if you get echo)
REACHY_SPEAKER_LEAD_MS=250     # speech buffered in the daemon; the most that plays on after a barge-in

# --- Optional: debugging ---
# Console verbosity: DEBUG | INFO (default) | WARNING | ERROR.
# DEBUG traces every OpenAI event, gesture and camera capture.
# REACHY_LOG_LEVEL=DEBUG
# Also write a full DEBUG log to a file (regardless of console level):
# REACHY_LOG_FILE=~/reachy-chat-debug.log
